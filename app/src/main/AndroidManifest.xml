<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- WorkManager declares this transitively; ClipVault never schedules network work. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".ClipVaultApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipVault"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Freeform (DeX) window floor only; phones ignore <layout>. Without it the main window
                 can be resized until the library shows filter chips but no clip, and until the four
                 top bar actions overflow. The floor is the smallest usable vault viewport: top bar
                 (64) + filter chips (48) + one clip card (142) + list padding (24) + bottom menu (80)
                 = 358dp; a two-line body requires +24dp (382dp), so the floor is rounded up to 384dp. The inline search stays
                 hidden below LibraryLayout.COMPACT_HEIGHT_DP, which is a separate threshold. -->
            <layout
                android:minHeight="384dp"
                android:minWidth="320dp" />
        </activity>

        <!-- Unexported: reached only through ClipVault's own launcher shortcut. Separate task, no recents
             entry, and config changes handled in place so a DeX resize does not cancel the biometric prompt. -->
        <activity
            android:name=".quickpaste.QuickPasteActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/quick_paste_title"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.quickpaste"
            android:windowSoftInputMode="stateVisible|adjustResize">
            <!-- Initial freeform (DeX) window size; phones ignore it and show the window full screen.
                 The minimum is the only size floor (Compose sets none): 240x260dp still fits the search
                 field, a few rows and the key hint (WP-06, QuickPasteCompactLayoutTest). -->
            <layout
                android:defaultHeight="620dp"
                android:defaultWidth="560dp"
                android:gravity="center"
                android:minHeight="260dp"
                android:minWidth="240dp" />
        </activity>

        <service
            android:name=".clipboard.ClipboardCaptureService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled encrypted clipboard history capture" />
        </service>

        <service
            android:name=".clipboard.ClipVaultTileService"
            android:exported="true"
            android:icon="@drawable/ic_vault"
            android:label="@string/quick_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
